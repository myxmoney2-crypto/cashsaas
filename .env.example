# Claude API (Anthropic) — console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe — un Price ID (récurrent, mensuel) par palier, créé dans Products
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# Repo template cloné chez chaque client par le bouton "Deploy to Vercel" (optionnel : cette valeur est le défaut)
NEXT_PUBLIC_GITHUB_TEMPLATE_REPO=myxmoney2-crypto/cashsaas-template

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
